rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    function isAdmin() {
      return role() == "Admin";
    }

    function isInvigilator() {
      return role() == "Invigilator";
    }

    function isStudent() {
      return role() == "Student";
    }

    match /users/{uid} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    match /securitySettings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isInvigilator();
    }

    match /liveSessions/{sessionId} {
      allow read: if isAdmin() || isInvigilator() || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /answers/{answerId} {
      allow read: if isAdmin() || isInvigilator() || resource.data.studentUid == request.auth.uid;
      allow create, update: if isStudent() && request.resource.data.studentUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /violations/{violationId} {
      allow read: if isAdmin() || isInvigilator() || resource.data.studentUid == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /startPasswords/{passwordId} {
      allow read, write: if isAdmin() || isInvigilator();
    }

    match /quitPasswords/{passwordId} {
      allow read, write: if isAdmin() || isInvigilator();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
