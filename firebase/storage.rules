rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /exam-evidence/{examId}/{studentUid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == studentUid;
    }

    match /reports/{examId}/{fileName} {
      allow read, write: if signedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
